[core]
    pager = delta
	compression = 0
[interactive]
    diffFilter = delta --color-only
[add.interactive]
    useBuiltin = false
[delta]
    navigate = true
    side-by-side = true
    light = false
[merge]
    conflictstyle = diff3
[diff]
    colorMoved = default

[init]
	defaultBranch = main
[alias]
    # Adds worktree to .worktrees folder
    wt = "!git worktree add .worktrees/$1 $1 #"
[pull]
	rebase = true

# Machine identity, signing and credentials stay outside the repository.
[include]
    path = ~/.gitconfig.local
